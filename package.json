{
  "name": "zee-time-records-app",
  "version": "1.0.8",
  "description": "DTR generator that imports ZKTeco USB flash-disk attendance dumps and produces CSC Form 48 style Daily Time Records.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5174 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:all": "vite build && electron-builder -mw"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.400.0",
    "mdb": "^0.1.0",
    "mdb-reader": "^3.2.0",
    "pdf-to-printer": "^5.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.jaybhee.zkteco-dtr",
    "productName": "Zee Time Records",
    "artifactName": "Zee-Time-Records-Setup-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "jaybhee84",
        "repo": "zee-time-records"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/ZeeTimeRecords.ico",
      "src/assets/ZeeTimeRecords.icns"
    ],
    "asarUnpack": [
      "**/node_modules/pdf-to-printer/**/*",
      "**/node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/ZeeTimeRecords.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/ZeeTimeRecords.icns",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zee Time Records",
      "perMachine": true,
      "runAfterFinish": true,
      "allowElevation": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
